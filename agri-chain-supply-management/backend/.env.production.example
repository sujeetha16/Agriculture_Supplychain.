# Production Cloud Environment Variables (AWS App Runner / Containerized Service)
PORT=5000
NODE_ENV=production

# Mandatory High-Entropy Cryptographic JWT Secret (minimum 32 characters, required in production)
JWT_SECRET=REPLACE_WITH_MANAGED_HIGH_ENTROPY_64_CHAR_HEX_SECRET

# Database Connection (MongoDB Atlas on AWS or Amazon DocumentDB with TLS)
MONGODB_URI=mongodb+srv://db_user:REPLACE_WITH_YOUR_STRONG_PASSWORD@cluster0.abcde.mongodb.net/agriculture_supply_chain?retryWrites=true&w=majority

# Authorized Web Origins for CORS (Explicit allowlist, no wildcards allowed for credentialed requests)
ALLOWED_ORIGINS=https://d111111abcdef8.cloudfront.net

# AgriChain Smart Contract Address deployed on Ethereum Sepolia
CONTRACT_ADDRESS=0xB601FDccec475b61B8Bc9f3661eC4F73B7499a2D

# Reliable Ethereum Sepolia JSON-RPC Endpoint (e.g. Infura, Alchemy, Tenderly)
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/REPLACE_WITH_INFURA_PROJECT_ID
