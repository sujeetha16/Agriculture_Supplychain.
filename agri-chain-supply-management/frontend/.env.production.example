# Production Cloud Environment Variables (Amazon S3 + CloudFront Build)
# URL of your AWS App Runner or EC2 Application Load Balancer API
VITE_API_URL=https://api.yourdomain.com/api

# Deployed Ethereum Sepolia Smart Contract Address
VITE_CONTRACT_ADDRESS=0xB601FDccec475b61B8Bc9f3661eC4F73B7499a2D

# Ethereum Sepolia Chain ID (Decimal)
VITE_CHAIN_ID=11155111

# Public Sepolia RPC Endpoint for read-only provenance queries
VITE_SEPOLIA_RPC_URL=https://rpc.sepolia.org
